<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fi.vm.sade.eperusteet</groupId>
        <artifactId>eperusteet-parent-pom</artifactId>
        <version>4.1.1-10</version>
        <relativePath/>
    </parent>

    <name>eperusteet-ylops-service</name>
    <artifactId>eperusteet-ylops-service</artifactId>
    <version>3.0.0</version>

    <properties>
        <springdoc.api.docs.url>http://localhost:8081/eperusteet-ylops-service/api-docs</springdoc.api.docs.url>
        <springdoc.output.file.name>ylops.spec.json</springdoc.output.file.name>
        <springdoc.api.docs.url.external>http://localhost:8081/eperusteet-ylops-service/api-docs/external</springdoc.api.docs.url.external>
        <springdoc.output.file.name.external>ylops-ext.spec.json</springdoc.output.file.name.external>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>eperusteet-ylops-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*DockerIT.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>docker-integration-test</id>
                        <goals>
                            <goal>integration-test</goal>
                        </goals>
                        <configuration>
                            <includes combine.self="override">
                                <include>**/*DockerIT.java</include>
                            </includes>
                            <excludes combine.self="override"/>
                            <forkCount>1</forkCount>
                            <reuseForks>false</reuseForks>
                            <failIfNoTests>false</failIfNoTests>
                            <forkedProcessTimeoutInSeconds>300</forkedProcessTimeoutInSeconds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Opetushallitus/eperusteet-ylops</url>
        </repository>
    </distributionManagement>

    <repositories>
        <repository>
            <id>github-eperusteet-backend-utils</id>
            <name>GitHub Packages eperusteet-backend-utils-maven-repo</name>
            <url>https://maven.pkg.github.com/Opetushallitus/eperusteet-backend-utils</url>
        </repository>
    </repositories>
</project>
